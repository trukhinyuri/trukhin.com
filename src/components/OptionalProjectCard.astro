---
interface Props { title: string; url: string; repo?: string | undefined; text: string }
const { title, url, repo, text } = Astro.props;
---
<article class="project-card">
  <h3><a href={url}>{title}</a></h3>
  <p>{text}</p>
  {repo && <p class="small"><a href={repo}>Source code</a></p>}
</article>

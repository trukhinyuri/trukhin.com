---
import { postUrl, SERIES, type Post } from '../../lib/posts';
interface Props { post: Post; series: Post[] }
const { post, series } = Astro.props;
const s = SERIES[post.data.series ?? ''];
const i = series.findIndex((p) => p.id === post.id);
const prev = i > 0 ? series[i - 1] : undefined;
const next = i >= 0 && i < series.length - 1 ? series[i + 1] : undefined;
---
{s && (
  <nav class="series-nav" aria-label={`${s.name} series`}>
    <p class="small muted">Part {post.data.seriesOrder} of <a href={`/blog/series/${s.slug}/`}>{s.name}</a></p>
    <ul>
      {prev && <li class="prev"><span class="small muted">Previous</span> <a href={postUrl(prev)} rel="prev" lang={prev.data.lang}>{prev.data.title}</a></li>}
      {next && <li class="next"><span class="small muted">Next</span> <a href={postUrl(next)} rel="next" lang={next.data.lang}>{next.data.title}</a></li>}
    </ul>
  </nav>
)}
